# WiFi credentials
WIFI_SSID="YourWiFiSSID"
WIFI_PASSWORD="YourWiFiPassword"

# Mesh SoftAP credentials
MESH_SOFTAP_SSID="ESP"
MESH_SOFTAP_PASSWORD="12345678"
MESH_ID=77

# MQTT Broker
MQTT_BROKER="broker.hivemq.com"
MQTT_PORT=1883
MQTT_USER=""
MQTT_PASSWORD=""

# =============================================================================
# Per-Environment Overrides
# =============================================================================
# Create .env.{envname} files to override settings for specific environments.
# Environment-specific files override values from the base .env file.
#
# Example: .env.lilygo-t3-s3-node
#   WIFI_SSID="WrongSSID"
#
# Example: .env.lilygo-t3-s3-root
#   WIFI_SSID="CorrectSSID"
#
# This allows testing mesh fallback by giving child nodes invalid router SSIDs
# while keeping credentials out of platformio.ini.
